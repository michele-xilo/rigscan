<?xml version="1.0"?>
<robot name="broken_arm">
  <link name="base">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <link name="upper_arm">
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><mesh filename="meshes/upper_arm.stl"/></geometry>
    </visual>
  </link>
  <link name="forearm">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="upper_arm"/>
    <axis xyz="0 0 1"/>
    <limit lower="1.57" upper="-1.57" effort="30" velocity="2"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="20" velocity="2"/>
  </joint>
  <joint name="wrist" type="revolute">
    <parent link="forearm"/>
    <child link="hand"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" effort="5" velocity="3"/>
  </joint>
</robot>
