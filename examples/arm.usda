#usda 1.0
(
    defaultPrim = "arm"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "arm" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 2
        point3f physics:centerOfMass = (0, 0, 0.05)
        float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
        def Cube "shape_0"
        {
            double size = 1
            double3 xformOp:translate = (0, 0, 0.05)
            double3 xformOp:scale = (0.2, 0.2, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "shape_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            uniform token purpose = "guide"
            double3 xformOp:translate = (0, 0, 0.05)
            double3 xformOp:scale = (0.2, 0.2, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
    def Xform "upper" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 1
        point3f physics:centerOfMass = (0, 0, 0.15)
        float3 physics:diagonalInertia = (0.02, 0.02, 0.002)
        def Cylinder "shape_0"
        {
            double radius = 0.04
            double height = 0.3
            uniform token axis = "Z"
            double3 xformOp:translate = (0, 0, 0.15)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "shape_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double radius = 0.04
            double height = 0.3
            uniform token axis = "Z"
            uniform token purpose = "guide"
            double3 xformOp:translate = (0, 0, 0.15)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def Xform "fore" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.5
        point3f physics:centerOfMass = (0, 0, 0.1)
        float3 physics:diagonalInertia = (0.005, 0.005, 0.001)
    }
    def Scope "joints"
    {
        def PhysicsFixedJoint "rootJoint"
        {
            rel physics:body1 = </arm/base>
        }
        def PhysicsRevoluteJoint "shoulder" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </arm/base>
            rel physics:body1 = </arm/upper>
            token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0, 0.1)
            float physics:lowerLimit = -85.94367
            float physics:upperLimit = 85.94367
            float drive:angular:physics:maxForce = 30
        }
        def PhysicsRevoluteJoint "elbow" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </arm/upper>
            rel physics:body1 = </arm/fore>
            token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0, 0.3)
            float physics:lowerLimit = 0
            float physics:upperLimit = 137.50987
            float drive:angular:physics:maxForce = 20
        }
    }
}
